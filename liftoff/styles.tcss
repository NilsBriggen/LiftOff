/* LiftOff — "sky & runway" terminal UI */

Screen {
    background: $background;
}

/* ----------------------------------------------------------------- top bar */
#topbar {
    height: 3;
    padding: 0 2;
    background: $panel;
    color: $text;
    border-bottom: tall $accent;
    content-align: left middle;
}

/* -------------------------------------------------------------- main layout */
#body {
    height: 1fr;
}

#left {
    width: 3fr;
    min-width: 44;
}

#search {
    height: 3;
    margin: 1 1 0 1;
    border: tall $surface-lighten-1;
    background: $surface;
}
#search:focus {
    border: tall $accent;
}

#table {
    height: 1fr;
    margin: 0 1 1 1;
    background: $surface;
    border: tall $surface-lighten-1;
}
#table:focus {
    border: tall $primary;
}
#table > .datatable--header {
    text-style: bold;
    color: $accent;
    background: $panel;
}
#table > .datatable--cursor {
    background: $primary;
    color: $text;
    text-style: bold;
}

#details {
    width: 1fr;
    min-width: 30;
    height: 1fr;
    margin: 1 1 1 0;
    padding: 1 2;
    background: $surface;
    border: tall $surface-lighten-1;
}
#details-title {
    text-style: bold;
    color: $accent;
}

#empty {
    height: 1fr;
    content-align: center middle;
    color: $text-muted;
}

/* ------------------------------------------------------------------- modals */
ModalScreen {
    align: center middle;
}
.dialog {
    width: 88;
    max-width: 94%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $panel;
    border: thick $accent;
}
.dialog-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}
.hint {
    color: $text-muted;
    padding: 1 0 0 0;
}
.dialog Input {
    margin: 1 0;
}
.dialog Label {
    padding-top: 1;
    color: $text-muted;
}
.buttons {
    height: auto;
    align: right middle;
    padding-top: 1;
}
.buttons Button {
    margin-left: 2;
}
#picker-tree {
    height: 14;
    border: tall $surface-lighten-1;
    background: $surface;
    margin: 1 0;
}
#dl-list, #sim-list, #fsto-list {
    height: 14;
    border: tall $surface-lighten-1;
    background: $surface;
    margin: 1 0;
}
.row-title {
    text-style: bold;
}
.row-sub {
    color: $text-muted;
}
HelpModal .dialog {
    width: 72;
}
